---

---

<section id="services" class="py-28 bg-white">
  <div class="max-w-7xl mx-auto px-6">
    <!-- TITLE -->
    <div class="text-center mb-20">
      <h2
        class="text-4xl md:text-5xl font-bold tracking-widest uppercase text-black"
      >
        Servicios
      </h2>
      <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">
        Soluciones digitales pensadas para crecer, escalar y convertir.
      </p>
    </div>

    <!-- CARDS -->
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <!-- CARD -->
      <div class="service-card">
        <img src="/sitiosWeb.webp" alt="Sitios Web" />
        <h3>Sitios Web</h3>
        <p>
          Diseñamos sitios rápidos, responsive y optimizados para convertir
          visitas en clientes reales.
        </p>
      </div>

      <div class="service-card">
        <img src="/diseño.webp" alt="Diseño Gráfico" />
        <h3>Diseño Gráfico</h3>
        <p>
          Branding, identidad visual y piezas gráficas que comunican el valor
          real de tu marca.
        </p>
      </div>

      <div class="service-card">
        <img src="/comunity.webp" alt="Community Manager" />
        <h3>Community Manager</h3>
        <p>
          Estrategias de contenido y gestión de redes enfocadas en comunidad,
          alcance y engagement.
        </p>
      </div>

      <div class="service-card">
        <img src="/ads.webp" alt="Ads Manager" />
        <h3>Ads Manager</h3>
        <p>
          Campañas en Meta Ads diseñadas para resultados medibles, no para
          gastar presupuesto.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .service-card {
    @apply bg-white rounded-2xl p-8 text-center shadow-md transition-all duration-300;
  }

  .service-card:hover {
    @apply -translate-y-2 shadow-xl;
  }

  .service-card img {
    @apply w-20 h-20 mx-auto mb-6 rounded-full;
  }

  .service-card h3 {
    @apply text-2xl font-semibold mb-4 text-gray-900;
  }

  .service-card p {
    @apply text-gray-600 leading-relaxed;
  }
</style>
