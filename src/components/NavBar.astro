---
import { Image } from "astro:assets";
---

<!-- NAVBAR -->
<nav class="fixed top-0 left-0 z-50 w-full bg-black/90 backdrop-blur-md">
  <div class="max-w-7xl mx-auto flex items-center justify-between px-6 py-4">
    <!-- LOGO -->
    <a href="/" class="flex items-center gap-3">
      <Image
        src="/logoNew.webp"
        alt="Logo Make Yourself See"
        width="200"
        height="200"
        loading="eager"
        decoding="async"
        class="w-10 h-10 rounded-full"
      />
      <h1 class="text-xl md:text-2xl font-bold uppercase tracking-wide">
        <span class="text-[#FAB927]">MAKE</span>
        <span class="text-white mx-1">YOURSELF</span>
        <span class="text-[#A61AD7]">SEE</span>
      </h1>
    </a>

    <!-- LINKS DESKTOP -->
    <div
      class="hidden md:flex text-xl items-center gap-8 uppercase font-semibold"
    >
      <a href="#aboutUs" class="nav-link">Nosotros</a>
      <a href="#services" class="nav-link">Servicios</a>
      <a href="#courses" class="nav-link">Cursos</a>
      <a href="#contact" class="nav-link">Contacto</a>
    </div>

    <!-- HAMBURGER -->
    <button
      id="menu-button"
      aria-label="Abrir menú"
      aria-expanded="false"
      class="md:hidden text-[#FAB927] focus:outline-none"
    >
      <svg
        class="w-7 h-7"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16m-7 6h7"></path>
      </svg>
    </button>
  </div>
</nav>

<!-- OVERLAY -->
<div
  id="overlay"
  class="fixed inset-0 bg-black/50 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity z-40"
>
</div>

<!-- DRAWER -->
<aside
  id="drawer"
  class="fixed top-0 left-0 z-50 h-full w-72 bg-[#A71BDB] -translate-x-full transition-transform duration-300 ease-out"
>
  <div class="flex items-center justify-between px-6 py-5">
    <span class="text-[#FAB927] uppercase font-semibold">Make Yourself See</span
    >
    <button id="close-button" aria-label="Cerrar menú">
      <svg
        class="w-5 h-5 text-white"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <nav class="px-4 space-y-2">
    <a href="#aboutUs" class="drawer-link">Nosotros</a>
    <a href="#services" class="drawer-link">Servicios</a>
    <a href="#courses" class="drawer-link">Cursos</a>
    <a href="#contact" class="drawer-link">Contacto</a>
  </nav>
</aside>

<!-- STYLES -->
<style>
  .nav-link {
    @apply text-[#FAB927] px-3 py-2 rounded-md transition-all duration-200;
  }
  .nav-link:hover {
    @apply bg-[#A61AD7] text-[#FAB927];
  }

  .drawer-link {
    @apply block text-white uppercase font-medium px-4 py-3 rounded-lg transition;
  }
  .drawer-link:hover {
    @apply bg-[#671585] text-[#FAB927];
  }
</style>

<!-- SCRIPT -->
<script>
  const button = document.getElementById("menu-button");
  const drawer = document.getElementById("drawer");
  const overlay = document.getElementById("overlay");
  const closeBtn = document.getElementById("close-button");
  const links = drawer.querySelectorAll("a");

  const openMenu = () => {
    drawer.classList.remove("-translate-x-full");
    overlay.classList.remove("opacity-0", "pointer-events-none");
    document.body.classList.add("overflow-hidden");
    button.setAttribute("aria-expanded", "true");
  };

  const closeMenu = () => {
    drawer.classList.add("-translate-x-full");
    overlay.classList.add("opacity-0", "pointer-events-none");
    document.body.classList.remove("overflow-hidden");
    button.setAttribute("aria-expanded", "false");
  };

  button.addEventListener("click", openMenu);
  closeBtn.addEventListener("click", closeMenu);
  overlay.addEventListener("click", closeMenu);

  links.forEach((link) => {
    link.addEventListener("click", closeMenu);
  });
</script>
